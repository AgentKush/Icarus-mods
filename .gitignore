# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/

# Temp scripts
*.py
# Allow validator script and site builder
!.github/scripts/*.py
!docs/build.py

# Build artifacts
Performance_Optimizer/PAK_Build/
# Site banner copies: docs/build.py makes them from */Banner.png on every site build
docs/banners/
*.bat
# ...except player-run tools that ship with a mod
!*/Restore_Kit_Research/*.bat
/tools/icarus_watcher
/tools/*
# ...except the game exporter (its own .gitignore keeps bin/obj/publish out)
!/tools/IcarusExport/
!/tools/IcarusExport/*.bat
.claude/

# Cleanup: backups + build staging
*.bak
pak_build/
.guide_assets/
