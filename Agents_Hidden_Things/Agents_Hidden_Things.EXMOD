          "Description": "NSLOCTEXT(\"D_Itemable\", \"Item_Agent_Hidden_Malformation_Saddle-Description\", \"Kit item contains 1x Malformation Saddle. A big saddle with its own models for 13 mounts (not the Bull, Blueback or Woolly Mammoth) that gives +6 cargo slots, +2 heavy cargo slots and +15% exposure resistance.\")",
          "FlavorText": "NSLOCTEXT(\"D_Itemable\", \"Item_Agent_Hidden_Malformation_Saddle-FlavorText\", \"Agent's Hidden Things kit\")",
          "Weight": 500
        },
        {
          "Name": "Item_Agent_Hidden_Radiation_Bomber_Vestige",
          "DisplayName": "NSLOCTEXT(\"D_Itemable\", \"Item_Agent_Hidden_Radiation_Bomber_Vestige-DisplayName\", \"Radiation Bomber Vestige Kit\")",
          "Icon": "/Game/Assets/2DArt/UI/Items/Item_Icons/Carcasses/T_ITEM_Radiation_Bomber_Head.T_ITEM_Radiation_Bomber_Head",
          "Description": "NSLOCTEXT(\"D_Itemable\", \"Item_Agent_Hidden_Radiation_Bomber_Vestige-Description\", \"Kit item contains 1x Radiation Bomber Vestige. A common vestige of the unreleased Radiation Bomber that the Hunter's Vestige Exchange takes for 1 Ren, like any common vestige.\")",
          "FlavorText": "NSLOCTEXT(\"D_Itemable\", \"Item_Agent_Hidden_Radiation_Bomber_Vestige-FlavorText\", \"Agent's Hidden Things kit\")",
          "Weight": 500
        },
        {
          "Name": "Item_Agent_Hidden_Radiation_Bomber_Trophy",
          "DisplayName": "NSLOCTEXT(\"D_Itemable\", \"Item_Agent_Hidden_Radiation_Bomber_Trophy-DisplayName\", \"Radiation Bomber Trophy Kit\")",
          "Icon": "/Game/Assets/2DArt/UI/Items/Item_Icons/Deployables/T_ITEM_Radiation_Bomber_Trophy.T_ITEM_Radiation_Bomber_Trophy",
          "Description": "NSLOCTEXT(\"D_Itemable\", \"Item_Agent_Hidden_Radiation_Bomber_Trophy-Description\", \"Kit item contains 1x Radiation Bomber Trophy. A mounted Radiation Bomber trophy you can place on a floor or a wall for +6 coziness.\")",
          "FlavorText": "NSLOCTEXT(\"D_Itemable\", \"Item_Agent_Hidden_Radiation_Bomber_Trophy-FlavorText\", \"Agent's Hidden Things kit\")",
          "Weight": 500
        },
        {
          "Name": "Item_Agent_Hidden_Heavy_Woolly_Mammoth_Saddle",
          "DisplayName": "NSLOCTEXT(\"D_Itemable\", \"Item_Agent_Hidden_Heavy_Woolly_Mammoth_Saddle-DisplayName\", \"Heavy Woolly Mammoth Saddle Kit\")",
          "Icon": "/Game/Assets/2DArt/UI/Items/Item_Icons/UseableItems/T_ITEM_Saddle_Mammoth_Standard.T_ITEM_Saddle_Mammoth_Standard",
          "Description": "NSLOCTEXT(\"D_Itemable\", \"Item_Agent_Hidden_Heavy_Woolly_Mammoth_Saddle-Description\", \"Kit item contains 1x Heavy Woolly Mammoth Saddle. A Woolly Mammoth saddle with +8 cargo slots and +1 heavy cargo slot that a mammoth can only wear after it learns the new Foundational creature talent (after Big Rig); the deployable platforms it promises are untested.\")",
          "FlavorText": "NSLOCTEXT(\"D_Itemable\", \"Item_Agent_Hidden_Heavy_Woolly_Mammoth_Saddle-FlavorText\", \"Agent's Hidden Things kit\")",
          "Weight": 500
        },
        {
          "Name": "Item_Agent_Hidden_Radiation_Grenade",
          "DisplayName": "NSLOCTEXT(\"D_Itemable\", \"Item_Agent_Hidden_Radiation_Grenade-DisplayName\", \"Radiation Grenade Kit\")",
          "Icon": "/Game/Assets/2DArt/UI/Items/Item_Icons/UseableItems/T_ITEM_Radiation_Grenade.T_ITEM_Radiation_Grenade",
          "Description": "NSLOCTEXT(\"D_Itemable\", \"Item_Agent_Hidden_Radiation_Grenade-Description\", \"Kit item contains 1x Radiation Grenade. A grenade that explodes on impact like the Impact Grenade, gives every player and creature in the blast (you included) 20 seconds of Radiation Grenade Sickness and leaves a radioactive patch for 30 seconds; launchers can fire it too.\")",
          "FlavorText": "NSLOCTEXT(\"D_Itemable\", \"Item_Agent_Hidden_Radiation_Grenade-FlavorText\", \"Agent's Hidden Things kit\")",
          "Weight": 500
        },
        {
          "Name": "Item_Agent_Hidden_EMP_Grenade",
          "DisplayName": "NSLOCTEXT(\"D_Itemable\", \"Item_Agent_Hidden_EMP_Grenade-DisplayName\", \"EMP Grenade Kit\")",
          "Icon": "/Game/Assets/2DArt/UI/Items/Item_Icons/UseableItems/T_ITEM_Grenade_Frag_Impact.T_ITEM_Grenade_Frag_Impact",
          "Description": "NSLOCTEXT(\"D_Itemable\", \"Item_Agent_Hidden_EMP_Grenade-Description\", \"Kit item contains 1x EMP Grenade. An impact grenade that deals light damage where it lands and cuts the energy flow of electrical devices in the blast for 30 seconds.\")",
          "FlavorText": "NSLOCTEXT(\"D_Itemable\", \"Item_Agent_Hidden_EMP_Grenade-FlavorText\", \"Agent's Hidden Things kit\")",
          "Weight": 500
        },
        {
          "Name": "Item_Agent_Hidden_T4_Backpack",
          "DisplayName": "NSLOCTEXT(\"D_Itemable\", \"Item_Agent_Hidden_T4_Backpack-DisplayName\", \"Camo Backpack Kit\")",
          "Icon": "/Game/Assets/2DArt/UI/Items/Item_Icons/UseableItems/T_ITEM_T4_Backpack.T_ITEM_T4_Backpack",
          "Description": "NSLOCTEXT(\"D_Itemable\", \"Item_Agent_Hidden_T4_Backpack-Description\", \"Kit item contains 1x Camo Backpack. A camouflaged backpack that adds 8 suit slots and 15 kg carry weight, lowers how threatening animals find you by 20% and makes crouch-walking 15% faster; it repairs with Cured Leather.\")",
          "FlavorText": "NSLOCTEXT(\"D_Itemable\", \"Item_Agent_Hidden_T4_Backpack-FlavorText\", \"Agent's Hidden Things kit\")",
          "Weight": 500
        },
        {
          "Name": "Item_Agent_Hidden_T5_Backpack",
          "DisplayName": "NSLOCTEXT(\"D_Itemable\", \"Item_Agent_Hidden_T5_Backpack-DisplayName\", \"Synthetic Backpack Kit\")",
          "Icon": "/Game/Assets/2DArt/UI/Items/Item_Icons/UseableItems/T_ITEM_T5_Backpack.T_ITEM_T5_Backpack",
          "Description": "NSLOCTEXT(\"D_Itemable\", \"Item_Agent_Hidden_T5_Backpack-Description\", \"Kit item contains 1x Synthetic Backpack. A synthetic backpack that adds 12 suit slots, 20 kg carry weight and 15% movement speed; it repairs with Cured Leather.\")",
          "FlavorText": "NSLOCTEXT(\"D_Itemable\", \"Item_Agent_Hidden_T5_Backpack-FlavorText\", \"Agent's Hidden Things kit\")",
          "Weight": 500
        },
        {
          "Name": "Item_Agent_Hidden_Animal_Virus",
          "DisplayName": "NSLOCTEXT(\"D_Itemable\", \"Item_Agent_Hidden_Animal_Virus-DisplayName\", \"Forced Evolution Virus Kit\")",
          "Icon": "/Game/Assets/2DArt/UI/Items/Item_Icons/UseableItems/T_ITEM_ForcedEvolutionVirus.T_ITEM_ForcedEvolutionVirus",
          "Description": "NSLOCTEXT(\"D_Itemable\", \"Item_Agent_Hidden_Animal_Virus-Description\", \"Kit item contains 1x Forced Evolution Virus. Look at a creature and left-click to inject it: its genetics are rerolled, it cannot be injected again for 5 minutes, and there is a 10% chance it becomes permanently infertile.\")",
          "FlavorText": "NSLOCTEXT(\"D_Itemable\", \"Item_Agent_Hidden_Animal_Virus-FlavorText\", \"Agent's Hidden Things kit\")",
          "Weight": 500
        },
        {
          "Name": "Item_Agent_Hidden_DNA_Serum",
          "DisplayName": "NSLOCTEXT(\"D_Itemable\", \"Item_Agent_Hidden_DNA_Serum-DisplayName\", \"DNA Augmentation Serum Kit\")",
          "Icon": "/Game/Assets/2DArt/UI/Items/Item_Icons/UseableItems/T_ITEM_DNA_AugmentationSerum.T_ITEM_DNA_AugmentationSerum",
          "Description": "NSLOCTEXT(\"D_Itemable\", \"Item_Agent_Hidden_DNA_Serum-Description\", \"Kit item contains 1x DNA Augmentation Serum. Left-click to inject yourself for +250 max health and +25 physical resistance for 10 minutes, or right-click a creature or NPC to give it the same boost for 100 minutes.\")",
          "FlavorText": "NSLOCTEXT(\"D_Itemable\", \"Item_Agent_Hidden_DNA_Serum-FlavorText\", \"Agent's Hidden Things kit\")",
          "Weight": 500
        },
        {
          "Name": "Item_Agent_Hidden_Settlement_Path_Placer",
          "DisplayName": "NSLOCTEXT(\"D_Itemable\", \"Item_Agent_Hidden_Settlement_Path_Placer-DisplayName\", \"Path Creator Kit\")",
          "Icon": "/Game/Assets/2DArt/UI/Icons/Icon_Agility.Icon_Agility",
          "Description": "NSLOCTEXT(\"D_Itemable\", \"Item_Agent_Hidden_Settlement_Path_Placer-Description\", \"Kit item contains 1x Path Creator. Lays the same road as the Road Kit and costs nothing to use; it starts in curved mode, and holding R switches between curved and straight.\")",
          "FlavorText": "NSLOCTEXT(\"D_Itemable\", \"Item_Agent_Hidden_Settlement_Path_Placer-FlavorText\", \"Agent's Hidden Things kit\")",
          "Weight": 500
        },
        {
          "Name": "Item_Agent_Hidden_Building_UpgradeTool",
          "DisplayName": "NSLOCTEXT(\"D_Itemable\", \"Item_Agent_Hidden_Building_UpgradeTool-DisplayName\", \"Building Upgrade Tool Kit\")",
          "Icon": "/Game/Assets/2DArt/UI/Items/Item_Icons/Tools/ITEM_Building_RepairTool.ITEM_Building_RepairTool",
          "Description": "NSLOCTEXT(\"D_Itemable\", \"Item_Agent_Hidden_Building_UpgradeTool-Description\", \"Kit item contains 1x Building Upgrade Tool. A hammer that only upgrades: hold R to pick a material, then right-click a fully repaired building piece to swap it for that material from your inventory.\")",
          "FlavorText": "NSLOCTEXT(\"D_Itemable\", \"Item_Agent_Hidden_Building_UpgradeTool-FlavorText\", \"Agent's Hidden Things kit\")",
          "Weight": 500
